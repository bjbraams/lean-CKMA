public import CKMA.Analysis.OrderedSpace.Bands.Projection
public import Mathlib.Algebra.BigOperators.Fin
public import Mathlib.Algebra.Order.Archimedean.Real.Basic

/-!
# Freudenthal component approximation

With a principal band projection assigned to every vector, a vector in the principal ideal
generated by a positive `u` is within an arbitrary positive multiple of `u` of a linear
combination of pairwise disjoint components of `u`. The argument is the spectral estimate
of Aliprantis–Burkinshaw, Theorem 2.8, rewritten for a signed vector.
-/

@[expose] public section

noncomputable section

set_option linter.unusedSectionVars false

namespace CKMA

open Finset

variable {E : Type*} [AddCommGroup E] [Lattice E] [Module ℝ E]
    [IsOrderedAddMonoid E] [IsOrderedModule ℝ E]

/-- A projection onto the double disjoint complement of `z⁺` reproduces that positive part. -/
theorem projection_eq_posPart {P : E →ₗ[ℝ] E} {z : E}
    (hrange : (LinearMap.range P : Set E) =
      latticeDisjointComplement (latticeDisjointComplement {z⁺}))
    (hidem : ∀ x, P (P x) = P x)
    (hcon : ∀ x, 0 ≤ x → 0 ≤ P x ∧ P x ≤ x) : P z = z⁺ := by
  have hz : z = z⁺ - z⁻ := (posPart_sub_negPart z).symm
  have hfix : P z⁺ = z⁺ := by
    refine contractiveProjection_eq_of_mem_range hidem ?_
    rw [← SetLike.mem_coe, hrange]
    exact mem_doubleLatticeDisjointComplement z⁺
  have hzero : P z⁻ = 0 := by
    have hmem : P z⁻ ∈ latticeDisjointComplement (latticeDisjointComplement {z⁺}) := by
      rw [← hrange]
      exact (SetLike.mem_coe).2 (LinearMap.mem_range_self P z⁻)
    have hzneg : z⁻ ∈ latticeDisjointComplement {z⁺} := by
      intro y hy
      have hy' : y = z⁺ := Set.mem_singleton_iff.mp hy
      rw [LatticeDisjoint, hy', abs_of_nonneg (negPart_nonneg z),
        abs_of_nonneg (posPart_nonneg z), inf_comm]
      exact posPart_inf_negPart_eq_zero z
    have hdisj : LatticeDisjoint (P z⁻) z⁻ := hmem z⁻ hzneg
    have hcon' := hcon z⁻ (negPart_nonneg z)
    have habs : P z⁻ ⊓ z⁻ = 0 := by
      simpa [LatticeDisjoint, abs_of_nonneg hcon'.1, abs_of_nonneg (negPart_nonneg z)] using hdisj
    have hinf : P z⁻ = P z⁻ ⊓ z⁻ := (inf_eq_left.2 hcon'.2).symm
    rw [hinf, habs]
  calc
    P z = P (z⁺ - z⁻) := by
      conv_lhs => rhs; rw [hz]
    _ = P z⁺ - P z⁻ := by rw [map_sub]
    _ = z⁺ := by rw [hfix, hzero, sub_zero]

/-- The difference of nested contractive projections is a component of a positive vector. -/
theorem nestedProjection_isLatticeComponent {P Q : E →ₗ[ℝ] E} {u : E} (hu : 0 ≤ u)
    (hPidem : ∀ x, P (P x) = P x) (hPcon : ∀ x, 0 ≤ x → 0 ≤ P x ∧ P x ≤ x)
    (hQidem : ∀ x, Q (Q x) = Q x) (hQcon : ∀ x, 0 ≤ x → 0 ≤ Q x ∧ Q x ≤ x)
    (hsubset : (LinearMap.range Q : Set E) ⊆ (LinearMap.range P : Set E)) :
    0 ≤ (P - Q) u ∧ (P - Q) u ≤ u ∧ (P - Q) u ⊓ (u - (P - Q) u) = 0 := by
  have hsub := contractiveProjection_sub hPidem hPcon hQidem hQcon hsubset
  refine ⟨(hsub.2 u hu).1, (hsub.2 u hu).2, ?_⟩
  exact contractiveProjection_disjoint_nonneg hsub.1 hsub.2 hu hu

/-- Scalar bounds for an increment of principal projections, as in Freudenthal's estimate. -/
theorem freudenthal_increment_bounds {P Q : E →ₗ[ℝ] E} {w1 u : E} {α β : ℝ}
    (hPidem : ∀ x, P (P x) = P x) (hPcon : ∀ x, 0 ≤ x → 0 ≤ P x ∧ P x ≤ x)
    (hQidem : ∀ x, Q (Q x) = Q x) (hQcon : ∀ x, 0 ≤ x → 0 ≤ Q x ∧ Q x ≤ x)
    (hsubset : (LinearMap.range Q : Set E) ⊆ (LinearMap.range P : Set E))
    (hP : P (w1 - α • u) = (w1 - α • u)⁺)
    (hQ : Q (w1 - β • u) = (w1 - β • u)⁺) :
    α • (P - Q) u ≤ (P - Q) w1 ∧ (P - Q) w1 ≤ β • (P - Q) u := by
  have hQP : Q.comp P = Q :=
    contractiveProjection_comp_left_eq_of_range_subset hPidem hPcon hQidem hQcon hsubset
  have hQPy : ∀ y, Q (P y) = Q y := by
    intro y
    rw [← LinearMap.comp_apply, hQP]
  have hlow : α • (P - Q) u ≤ (P - Q) w1 := by
    set z := w1 - α • u
    have heq : (P - Q) z = z⁺ - Q z⁺ := by
      have hQz : Q z = Q z⁺ := by rw [← hQPy z, hP]
      calc
        (P - Q) z = P z - Q z := by simp only [LinearMap.sub_apply]
        _ = z⁺ - Q z := by rw [hP]
        _ = z⁺ - Q z⁺ := by rw [hQz]
    have hnn : 0 ≤ z⁺ - Q z⁺ :=
      contractiveProjection_complement_nonneg (fun y hy => (hQcon y hy).2) (posPart_nonneg z)
    have hlin : (P - Q) z = (P - Q) w1 - α • (P - Q) u := by
      rw [map_sub, map_smul]
    have hsub : 0 ≤ (P - Q) w1 - α • (P - Q) u := by
      rw [← hlin, heq]
      exact hnn
    exact (sub_nonneg).1 hsub
  have hhigh : (P - Q) w1 ≤ β • (P - Q) u := by
    set z := w1 - β • u
    have hmono : Monotone P := positiveLinearMap_monotone (fun y hy => (hPcon y hy).1)
    have hfix : P z⁺ = z⁺ := by
      refine contractiveProjection_eq_of_mem_range hPidem ?_
      exact hsubset ⟨z, hQ⟩
    have hle : (P - Q) z ≤ 0 := by
      calc
        (P - Q) z = P z - Q z := by simp only [LinearMap.sub_apply]
        _ = P z - z⁺ := by rw [hQ]
        _ ≤ P z⁺ - z⁺ := sub_le_sub_right (hmono (le_sup_left : z ≤ z⁺)) z⁺
        _ = 0 := by rw [hfix, sub_self]
    have hlin : (P - Q) z = (P - Q) w1 - β • (P - Q) u := by
      rw [map_sub, map_smul]
    have hsub : (P - Q) w1 - β • (P - Q) u ≤ 0 := by
      rw [← hlin]
      exact hle
    exact (sub_nonpos).1 hsub
  exact ⟨hlow, hhigh⟩

/-- **Freudenthal approximation** from the principal projection property.
`hp` is the raw form of `HasPrincipalBandProjections`. -/
theorem freudenthal_components
    (hp : ∀ u : E, ∃ P : E →ₗ[ℝ] E,
      (LinearMap.range P : Set E) =
        latticeDisjointComplement (latticeDisjointComplement {u}) ∧
      (∀ x, P (P x) = P x) ∧ ∀ x, 0 ≤ x → 0 ≤ P x ∧ P x ≤ x)
    {u x : E} (hu : 0 ≤ u) (hx : ∃ c : ℝ, 0 ≤ c ∧ |x| ≤ c • u) {ε : ℝ} (hε : 0 < ε) :
    ∃ (n : ℕ) (a : Fin n → ℝ) (v : Fin n → E),
      (∀ i, 0 ≤ v i ∧ v i ≤ u ∧ v i ⊓ (u - v i) = 0) ∧
      (∀ i j, i ≠ j → LatticeDisjoint (v i) (v j)) ∧
      |x - ∑ i, a i • v i| ≤ ε • u := by
  obtain ⟨c, hc0, hxc⟩ := hx
  set c1 : ℝ := c + 1
  have hc1 : 0 < c1 := by dsimp [c1]; linarith
  set lam : ℝ := 2 * c1
  have hlam : 0 < lam := by dsimp [lam]; linarith
  set w : E := x + c1 • u
  have hx_le_abs : -|x| ≤ x := by
    have hneg : -x ≤ |x| := by
      rw [← abs_neg]
      exact le_abs_self (-x)
    simpa using neg_le_neg hneg
  have hc1c : c1 - c = 1 := by dsimp [c1]; ring
  have hw0 : 0 ≤ w := by
    have hbase : 0 ≤ (c1 - c) • u := by
      rw [hc1c, one_smul]
      exact hu
    have hrest : (c1 - c) • u = -(c • u) + c1 • u := by
      rw [sub_smul]
      abel
    calc
      0 ≤ (c1 - c) • u := hbase
      _ = -(c • u) + c1 • u := hrest
      _ ≤ -|x| + c1 • u := add_le_add_left (neg_le_neg hxc) _
      _ ≤ x + c1 • u := add_le_add_left hx_le_abs _
  have hclam : c + c1 ≤ lam := by dsimp [c1, lam]; linarith
  have hwlam : w ≤ lam • u := by
    calc
      w = x + c1 • u := rfl
      _ ≤ |x| + c1 • u := add_le_add_left (le_abs_self x) _
      _ ≤ c • u + c1 • u := add_le_add_left hxc _
      _ = (c + c1) • u := by rw [← add_smul]
      _ ≤ lam • u := smul_le_smul_of_nonneg_right hclam hu
  set w1 : E := lam⁻¹ • w
  have hw10 : 0 ≤ w1 := smul_nonneg (inv_nonneg.2 hlam.le) hw0
  have hw1u : w1 ≤ u := by
    have hmul := smul_le_smul_of_nonneg_left hwlam (inv_nonneg.2 hlam.le)
    have hcancel : lam⁻¹ • (lam • u) = u := by
      rw [← mul_smul, inv_mul_cancel₀ hlam.ne', one_smul]
    simpa [w1, hcancel] using hmul
  have hw1w : lam • w1 = w := by
    dsimp [w1]
    rw [← mul_smul, mul_inv_cancel₀ hlam.ne', one_smul]
  let carrier : ℝ → E := fun t => (w1 - t • u)⁺
  let proj : ℝ → E →ₗ[ℝ] E := fun t => Classical.choose (hp (carrier t))
  have hrange : ∀ t, (LinearMap.range (proj t) : Set E) =
      latticeDisjointComplement (latticeDisjointComplement {carrier t}) :=
    fun t => (Classical.choose_spec (hp (carrier t))).1
  have hidem : ∀ t, ∀ y, proj t (proj t y) = proj t y :=
    fun t => (Classical.choose_spec (hp (carrier t))).2.1
  have hcon : ∀ t, ∀ y, 0 ≤ y → 0 ≤ proj t y ∧ proj t y ≤ y :=
    fun t => (Classical.choose_spec (hp (carrier t))).2.2
  have happly : ∀ t, proj t (w1 - t • u) = carrier t := by
    intro t
    have hrange' : (LinearMap.range (proj t) : Set E) =
        latticeDisjointComplement (latticeDisjointComplement {(w1 - t • u)⁺}) := by
      simpa [carrier] using hrange t
    simpa [carrier] using projection_eq_posPart hrange' (hidem t) (hcon t)
  have hcarrier_anti : ∀ {s t : ℝ}, s ≤ t → carrier t ≤ carrier s := by
    intro s t hst
    have hsm : s • u ≤ t • u := smul_le_smul_of_nonneg_right hst hu
    exact sup_le_sup_right (sub_le_sub_left hsm w1) 0
  have hrange_anti : ∀ {s t : ℝ}, s ≤ t →
      (LinearMap.range (proj t) : Set E) ⊆ (LinearMap.range (proj s) : Set E) := by
    intro s t hst
    rw [hrange t, hrange s]
    exact doubleLatticeDisjointComplement_mono (posPart_nonneg _) (hcarrier_anti hst)
  have hcarrier0 : carrier 0 = w1 := by
    simp [carrier, zero_smul, sub_zero, posPart_eq_self.2 hw10]
  have hproj0w1 : proj 0 w1 = w1 := by
    have hmem : w1 ∈ LinearMap.range (proj 0) := by
      rw [← SetLike.mem_coe, hrange 0, hcarrier0]
      exact mem_doubleLatticeDisjointComplement w1
    exact contractiveProjection_eq_of_mem_range (hidem 0) hmem
  have hcarrier1 : carrier 1 = 0 := by
    have hle : w1 - (1 : ℝ) • u ≤ 0 := by
      rw [one_smul]
      exact sub_nonpos.2 hw1u
    simpa [carrier] using posPart_eq_zero_of_nonpos hle
  have hproj1 : ∀ y, proj 1 y = 0 := by
    intro y
    have hy : proj 1 y ∈ (LinearMap.range (proj 1) : Set E) :=
      (SetLike.mem_coe).2 (LinearMap.mem_range_self (proj 1) y)
    rw [hrange 1, hcarrier1, doubleLatticeDisjointComplement_zero] at hy
    exact Set.mem_singleton_iff.mp hy
  obtain ⟨N, hN⟩ := exists_nat_gt (lam / ε)
  have hN0 : 0 < N := Nat.cast_pos.mp ((div_pos hlam hε).trans hN)
  have hNpos : (0 : ℝ) < N := Nat.cast_pos.mpr hN0
  have hdiv : lam / (N : ℝ) < ε := by
    have hlt : lam < ε * (N : ℝ) := by
      simpa [mul_comm] using (div_lt_iff₀ hε).mp hN
    exact (div_lt_iff₀ hNpos).mpr hlt
  let g : ℕ → E := fun k => proj ((k : ℝ) / (N : ℝ)) u
  let f : ℕ → E := fun k => proj ((k : ℝ) / (N : ℝ)) w1
  have hscale0 : ((0 : ℕ) : ℝ) / (N : ℝ) = 0 := by simp
  have hscaleN : ((N : ℕ) : ℝ) / (N : ℝ) = 1 := by
    rw [div_self hNpos.ne']
  have hf0 : f 0 = w1 := by
    unfold f
    rw [hscale0, hproj0w1]
  have hfN : f N = 0 := by simp [f, hscaleN, hproj1]
  have hgN : g N = 0 := by simp [g, hscaleN, hproj1]
  have hpoint : ∀ i ∈ range N,
      ((i : ℝ) / (N : ℝ)) • (g i - g (i + 1)) ≤ f i - f (i + 1) ∧
        f i - f (i + 1) ≤ (((i : ℝ) + 1) / (N : ℝ)) • (g i - g (i + 1)) := by
    intro i _hi
    have hαβ : (i : ℝ) / (N : ℝ) ≤ ((i : ℝ) + 1) / (N : ℝ) := by
      exact div_le_div_of_nonneg_right (by linarith) hNpos.le
    have hsub := hrange_anti hαβ
    have hP := happly ((i : ℝ) / (N : ℝ))
    have hQ := happly (((i : ℝ) + 1) / (N : ℝ))
    have hbounds := freudenthal_increment_bounds (hidem _) (hcon _) (hidem _) (hcon _) hsub hP hQ
    simpa [f, g, Nat.cast_add, Nat.cast_one] using hbounds
  set s : E := ∑ i ∈ range N, ((i : ℝ) / (N : ℝ)) • (g i - g (i + 1))
  have htele_f : ∑ i ∈ range N, (f i - f (i + 1)) = w1 := by
    rw [sum_range_sub, hf0, hfN, sub_zero]
  have htele_g : ∑ i ∈ range N, (g i - g (i + 1)) = g 0 := by
    rw [sum_range_sub, hgN, sub_zero]
  have hs_le : s ≤ w1 := by
    have hle : s ≤ ∑ i ∈ range N, (f i - f (i + 1)) := by
      refine Finset.sum_le_sum ?_
      intro i hi
      exact (hpoint i hi).1
    exact hle.trans (le_of_eq htele_f)
  have hw1_le : w1 ≤ s + ((1 : ℝ) / (N : ℝ)) • (g 0) := by
    have hle : ∑ i ∈ range N, (f i - f (i + 1)) ≤
        ∑ i ∈ range N, (((i : ℝ) + 1) / (N : ℝ)) • (g i - g (i + 1)) := by
      refine Finset.sum_le_sum ?_
      intro i hi
      exact (hpoint i hi).2
    have hsplit : ∑ i ∈ range N, (((i : ℝ) + 1) / (N : ℝ)) • (g i - g (i + 1)) =
        s + ((1 : ℝ) / (N : ℝ)) • ∑ i ∈ range N, (g i - g (i + 1)) := by
      have hterm : ∀ i ∈ range N, (((i : ℝ) + 1) / (N : ℝ)) • (g i - g (i + 1)) =
          ((i : ℝ) / (N : ℝ)) • (g i - g (i + 1)) +
            ((1 : ℝ) / (N : ℝ)) • (g i - g (i + 1)) := by
        intro i _hi
        have hadd : ((i : ℝ) + 1) / (N : ℝ) = (i : ℝ) / (N : ℝ) + (1 : ℝ) / (N : ℝ) := by
          rw [add_div]
        rw [hadd, add_smul]
      rw [Finset.sum_congr rfl hterm, Finset.sum_add_distrib, ← Finset.smul_sum]
    rw [htele_f] at hle
    rw [hsplit, htele_g] at hle
    exact hle
  have hg0_le : g 0 ≤ u := (hcon (((0 : ℕ) : ℝ) / (N : ℝ)) u hu).2
  have hgnorm : ((1 : ℝ) / (N : ℝ)) • g 0 ≤ ((1 : ℝ) / (N : ℝ)) • u :=
    smul_le_smul_of_nonneg_left hg0_le (div_nonneg zero_le_one hNpos.le)
  have herr1 : 0 ≤ w1 - s := sub_nonneg.2 hs_le
  have herr2 : w1 - s ≤ ((1 : ℝ) / (N : ℝ)) • u := by
    have hle : w1 ≤ s + ((1 : ℝ) / (N : ℝ)) • u :=
      hw1_le.trans (add_le_add_right hgnorm s)
    exact (sub_le_iff_le_add').2 hle
  let v : Fin (N + 1) → E := fun i =>
    if h : (i : ℕ) < N then g i - g (i + 1) else u - g 0
  let a : Fin (N + 1) → ℝ := fun i =>
    if h : (i : ℕ) < N then lam * ((i : ℝ) / (N : ℝ)) - c1 else -c1
  have hv_cast : ∀ i : Fin N, v i.castSucc = g i - g (i + 1) := by
    intro i
    have hi : (i.castSucc : ℕ) < N := by
      rw [Fin.val_castSucc]
      exact i.isLt
    unfold v
    rw [dite_eq_left hi, Fin.val_castSucc]
  have ha_cast : ∀ i : Fin N, a i.castSucc = lam * ((i : ℝ) / (N : ℝ)) - c1 := by
    intro i
    have hi : (i.castSucc : ℕ) < N := by
      rw [Fin.val_castSucc]
      exact i.isLt
    unfold a
    rw [dite_eq_left hi, Fin.val_castSucc]
  have hv_last : v (Fin.last N) = u - g 0 := by
    have hi : ¬ (Fin.last N : ℕ) < N := by
      rw [Fin.val_last]
      exact Nat.lt_irrefl _
    unfold v
    rw [dite_eq_right hi]
  have ha_last : a (Fin.last N) = -c1 := by
    have hi : ¬ (Fin.last N : ℕ) < N := by
      rw [Fin.val_last]
      exact Nat.lt_irrefl _
    unfold a
    rw [dite_eq_right hi]
  have hsum : ∑ i : Fin (N + 1), a i • v i = lam • s - c1 • u := by
    rw [Fin.sum_univ_castSucc]
    have hhead : ∑ i : Fin N, a i.castSucc • v i.castSucc =
        lam • s - c1 • ∑ i ∈ range N, (g i - g (i + 1)) := by
      have hfun : ∑ i : Fin N, a i.castSucc • v i.castSucc =
          ∑ i ∈ range N, (lam * ((i : ℝ) / (N : ℝ)) - c1) • (g i - g (i + 1)) := by
        refine Eq.trans ?_ (Finset.sum_range (fun i =>
          (lam * ((i : ℝ) / (N : ℝ)) - c1) • (g i - g (i + 1)))).symm
        refine Finset.sum_congr rfl ?_
        intro i _
        rw [ha_cast, hv_cast]
      rw [hfun]
      have hterm : ∀ i ∈ range N,
          (lam * ((i : ℝ) / (N : ℝ)) - c1) • (g i - g (i + 1)) =
            lam • (((i : ℝ) / (N : ℝ)) • (g i - g (i + 1))) -
              c1 • (g i - g (i + 1)) := by
        intro i _hi
        rw [sub_smul, mul_smul]
      rw [Finset.sum_congr rfl hterm, Finset.sum_sub_distrib, ← Finset.smul_sum,
        ← Finset.smul_sum]
    have htail : a (Fin.last N) • v (Fin.last N) = - (c1 • (u - g 0)) := by
      rw [ha_last, hv_last, neg_smul]
    rw [hhead, htail, htele_g]
    have hgu : g 0 + (u - g 0) = u := by abel
    calc
      lam • s - c1 • g 0 + -(c1 • (u - g 0))
          = lam • s - (c1 • g 0 + c1 • (u - g 0)) := by abel
      _ = lam • s - c1 • (g 0 + (u - g 0)) := by rw [← smul_add]
      _ = lam • s - c1 • u := by rw [hgu]
  have hxw : x = w - c1 • u := by
    dsimp [w]
    abel
  have herr : x - ∑ i, a i • v i = lam • (w1 - s) := by
    rw [hsum, hxw]
    calc
      w - c1 • u - (lam • s - c1 • u) = w - lam • s := by abel
      _ = lam • w1 - lam • s := by rw [← hw1w]
      _ = lam • (w1 - s) := by rw [← smul_sub]
  have habs : |lam • (w1 - s)| = lam • |w1 - s| := by
    rw [abs_smul, abs_of_nonneg hlam.le]
  have hmesh : |w1 - s| ≤ ((1 : ℝ) / (N : ℝ)) • u := by
    rw [abs_of_nonneg herr1]
    exact herr2
  have hfinal : |x - ∑ i, a i • v i| ≤ ε • u := by
    rw [herr, habs]
    have hmul := smul_le_smul_of_nonneg_left hmesh hlam.le
    have hscale : lam • (((1 : ℝ) / (N : ℝ)) • u) = (lam / (N : ℝ)) • u := by
      rw [← mul_smul, div_eq_mul_inv]
      ring_nf
    have hcoeff : (lam / (N : ℝ)) • u ≤ ε • u :=
      smul_le_smul_of_nonneg_right (le_of_lt hdiv) hu
    exact (hmul.trans (by rw [hscale])).trans hcoeff
  have hcomp_step : ∀ i : ℕ, i < N →
      0 ≤ g i - g (i + 1) ∧ g i - g (i + 1) ≤ u ∧
        (g i - g (i + 1)) ⊓ (u - (g i - g (i + 1))) = 0 := by
    intro i hi
    have hαβ : (i : ℝ) / (N : ℝ) ≤ ((i : ℝ) + 1) / (N : ℝ) :=
      div_le_div_of_nonneg_right (by linarith) hNpos.le
    have hcomp := nestedProjection_isLatticeComponent hu
      (hidem ((i : ℝ) / (N : ℝ))) (hcon ((i : ℝ) / (N : ℝ)))
      (hidem (((i : ℝ) + 1) / (N : ℝ))) (hcon (((i : ℝ) + 1) / (N : ℝ)))
      (hrange_anti hαβ)
    have hgi : g i = proj ((i : ℝ) / (N : ℝ)) u := by
      unfold g
      rfl
    have hgi1 : g (i + 1) = proj (((i : ℝ) + 1) / (N : ℝ)) u := by
      unfold g
      rw [Nat.cast_succ]
    simp only [LinearMap.sub_apply] at hcomp
    rw [← hgi, ← hgi1] at hcomp
    exact hcomp
  have hcomp_rest : 0 ≤ u - g 0 ∧ u - g 0 ≤ u ∧ (u - g 0) ⊓ g 0 = 0 := by
    have hsubset : (LinearMap.range (proj 0) : Set E) ⊆
        (LinearMap.range (LinearMap.id : E →ₗ[ℝ] E) : Set E) := by
      intro y _hy
      exact (SetLike.mem_coe).2
        (LinearMap.mem_range_self (LinearMap.id : E →ₗ[ℝ] E) y)
    have hid : ∀ y : E,
        (LinearMap.id : E →ₗ[ℝ] E) ((LinearMap.id : E →ₗ[ℝ] E) y) =
          (LinearMap.id : E →ₗ[ℝ] E) y := fun _y => rfl
    have hcid : ∀ y : E, 0 ≤ y →
        0 ≤ (LinearMap.id : E →ₗ[ℝ] E) y ∧
          (LinearMap.id : E →ₗ[ℝ] E) y ≤ y :=
      fun y hy => ⟨hy, le_rfl⟩
    have hcomp := nestedProjection_isLatticeComponent hu hid hcid (hidem 0) (hcon 0) hsubset
    have hg0 : g 0 = proj 0 u := by
      unfold g
      rw [hscale0]
    simp only [LinearMap.id_apply, LinearMap.sub_apply] at hcomp
    rw [← hg0] at hcomp
    have hcancel : u - (u - g 0) = g 0 := by abel
    rw [hcancel] at hcomp
    exact hcomp
  have hlast_unique : ∀ i : Fin (N + 1), ¬ (i : ℕ) < N → i = Fin.last N := by
    intro i hi
    exact Fin.ext (le_antisymm (Nat.lt_succ_iff.mp i.isLt) (Nat.not_lt.mp hi))
  have hg_anti : ∀ {p q : ℕ}, p ≤ q → g q ≤ g p := by
    intro p q hpq
    have hst : (p : ℝ) / (N : ℝ) ≤ (q : ℝ) / (N : ℝ) :=
      div_le_div_of_nonneg_right (Nat.cast_le.mpr hpq) hNpos.le
    unfold g
    exact contractiveProjection_le_of_range_subset
      (hidem ((p : ℝ) / (N : ℝ))) (hcon ((p : ℝ) / (N : ℝ)))
      (hcon ((q : ℝ) / (N : ℝ))) (hrange_anti hst) hu
  have hdisj_nat : ∀ {p q : ℕ}, p < q → q < N →
      LatticeDisjoint (g p - g (p + 1)) (g q - g (q + 1)) := by
    intro p q hpq _hq
    have hp1 : p + 1 ≤ q := Nat.succ_le_of_lt hpq
    have hgp : g (p + 1) ≤ g p := hg_anti (Nat.le_succ p)
    have hgq : g (q + 1) ≤ g q := hg_anti (Nat.le_succ q)
    have hgqp : g q ≤ g (p + 1) := hg_anti hp1
    have hgpu : g p ≤ u := by
      unfold g
      exact (hcon ((p : ℝ) / (N : ℝ)) u hu).2
    have hvp : 0 ≤ g p - g (p + 1) := sub_nonneg.2 hgp
    have hvq : 0 ≤ g q - g (q + 1) := sub_nonneg.2 hgq
    have hle1 : g p - g (p + 1) ≤ u - g (p + 1) :=
      sub_le_sub_right hgpu (g (p + 1))
    have hq1 : 0 ≤ g (q + 1) := by
      unfold g
      exact (hcon (((q + 1 : ℕ) : ℝ) / (N : ℝ)) u hu).1
    have hle2 : g q - g (q + 1) ≤ g (p + 1) := (sub_le_self _ hq1).trans hgqp
    have hinf0 : (u - g (p + 1)) ⊓ g (p + 1) = 0 := by
      have hdis := contractiveProjection_disjoint_nonneg
        (hidem (((p + 1 : ℕ) : ℝ) / (N : ℝ)))
        (hcon (((p + 1 : ℕ) : ℝ) / (N : ℝ))) hu hu
      have hg1 : g (p + 1) = proj (((p + 1 : ℕ) : ℝ) / (N : ℝ)) u := by
        unfold g
        rfl
      rw [← hg1, inf_comm] at hdis
      exact hdis
    rw [LatticeDisjoint, abs_of_nonneg hvp, abs_of_nonneg hvq]
    exact le_antisymm ((inf_le_inf hle1 hle2).trans (le_of_eq hinf0)) (le_inf hvp hvq)
  have hdisj_rest : ∀ {p : ℕ}, p < N →
      LatticeDisjoint (g p - g (p + 1)) (u - g 0) := by
    intro p _hp
    have hgp : g (p + 1) ≤ g p := hg_anti (Nat.le_succ p)
    have hgle : g p ≤ g 0 := hg_anti (Nat.zero_le p)
    have hvp : 0 ≤ g p - g (p + 1) := sub_nonneg.2 hgp
    have hvr : 0 ≤ u - g 0 := hcomp_rest.1
    have hp1 : 0 ≤ g (p + 1) := by
      unfold g
      exact (hcon (((p + 1 : ℕ) : ℝ) / (N : ℝ)) u hu).1
    have hle : g p - g (p + 1) ≤ g 0 := (sub_le_self _ hp1).trans hgle
    have h0 : g 0 ⊓ (u - g 0) = 0 := by simpa [inf_comm] using hcomp_rest.2.2
    rw [LatticeDisjoint, abs_of_nonneg hvp, abs_of_nonneg hvr]
    exact le_antisymm ((inf_le_inf_right _ hle).trans (le_of_eq h0)) (le_inf hvp hvr)
  refine ⟨N + 1, a, v, ?_, ?_, hfinal⟩
  · intro i
    by_cases hi : (i : ℕ) < N
    · have hvi : v i = g (i : ℕ) - g ((i : ℕ) + 1) := by
        unfold v
        rw [dite_eq_left hi]
      rw [hvi]
      exact hcomp_step (i : ℕ) hi
    · have hi' : i = Fin.last N := hlast_unique i hi
      have hcancel : u - (u - g 0) = g 0 := by abel
      rw [hi', hv_last, hcancel]
      exact hcomp_rest
  · intro i j hij
    by_cases hi : (i : ℕ) < N
    · by_cases hj : (j : ℕ) < N
      · have hijN : (i : ℕ) ≠ (j : ℕ) := fun h => hij (Fin.ext h)
        have hvi : v i = g (i : ℕ) - g ((i : ℕ) + 1) := by
          unfold v
          rw [dite_eq_left hi]
        have hvj : v j = g (j : ℕ) - g ((j : ℕ) + 1) := by
          unfold v
          rw [dite_eq_left hj]
        rw [hvi, hvj]
        rcases lt_or_gt_of_ne hijN with hlt | hgt
        · exact hdisj_nat hlt hj
        · exact (hdisj_nat hgt hi).symm
      · have hj' : j = Fin.last N := hlast_unique j hj
        have hvi : v i = g (i : ℕ) - g ((i : ℕ) + 1) := by
          unfold v
          rw [dite_eq_left hi]
        rw [hvi, hj', hv_last]
        exact hdisj_rest hi
    · have hi' : i = Fin.last N := hlast_unique i hi
      have hj : (j : ℕ) < N := by
        by_contra hjn
        exact hij (hi'.trans (hlast_unique j hjn).symm)
      have hvj : v j = g (j : ℕ) - g ((j : ℕ) + 1) := by
        unfold v
        rw [dite_eq_left hj]
      rw [hi', hv_last, hvj]
      exact (hdisj_rest hj).symm

end CKMA
