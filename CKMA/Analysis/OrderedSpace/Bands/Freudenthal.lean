/-!
# Freudenthal component approximation

With a principal band projection assigned to every vector, a vector in the principal ideal
generated by a positive `u` is within an arbitrary positive multiple of `u` of a linear
combination of pairwise disjoint components of `u`. The argument is the spectral estimate
of Aliprantis–Burkinshaw, Theorem 2.8, rewritten for a signed vector.

## Main results

* `CKMA.projection_eq_posPart`: a contractive projection onto `{z⁺}ᵈᵈ` maps `z` to `z⁺`.
* `CKMA.freudenthal_increment_bounds`: scalar bounds for an increment of principal projections.
* `CKMA.freudenthal_components`: Freudenthal spectral approximation by disjoint components.
-/

public section

noncomputable section

namespace CKMA

open Finset

variable {E : Type*} [AddCommGroup E] [Lattice E] [Module ℝ E]
    [IsOrderedAddMonoid E] [IsOrderedModule ℝ E]

omit [IsOrderedModule ℝ E] in
/-- A projection onto the double disjoint complement of `z⁺` reproduces that positive part. -/
theorem projection_eq_posPart {P : E →ₗ[ℝ] E} {z : E}
    (hrange : (LinearMap.range P : Set E) =
      latticeDisjointComplement (latticeDisjointComplement {z⁺}))
    (hidem : ∀ x, P (P x) = P x)
    (hcon : ∀ x, 0 ≤ x → 0 ≤ P x ∧ P x ≤ x) : P z = z⁺ := by
  have hz : z = z⁺ - z⁻ := (posPart_sub_negPart z).symm
  have hfix : P z⁺ = z⁺ := by
    refine contractiveProjection_eq_of_mem_range hidem ?_
    rw [← SetLike.mem_coe, hrange]
    exact mem_doubleLatticeDisjointComplement z⁺
  have hzero : P z⁻ = 0 := by
    have hmem : P z⁻ ∈ latticeDisjointComplement (latticeDisjointComplement {z⁺}) := by
      rw [← hrange]
      exact (SetLike.mem_coe).2 (LinearMap.mem_range_self P z⁻)
    have hzneg : z⁻ ∈ latticeDisjointComplement {z⁺} := by
      intro y hy
      have hy' : y = z⁺ := Set.mem_singleton_iff.mp hy
      rw [LatticeDisjoint, hy', abs_of_nonneg (negPart_nonneg z),
        abs_of_nonneg (posPart_nonneg z), inf_comm]
      exact posPart_inf_negPart_eq_zero z
    have hdisj : LatticeDisjoint (P z⁻) z⁻ := hmem z⁻ hzneg
    have hcon' := hcon z⁻ (negPart_nonneg z)
    have habs : P z⁻ ⊓ z⁻ = 0 := by
      simpa [LatticeDisjoint, abs_of_nonneg hcon'.1, abs_of_nonneg (negPart_nonneg z)] using hdisj
    have hinf : P z⁻ = P z⁻ ⊓ z⁻ := (inf_eq_left.2 hcon'.2).symm
    rw [hinf, habs]
  calc
    P z = P (z⁺ - z⁻) := by
      conv_lhs => rhs; rw [hz]
    _ = P z⁺ - P z⁻ := by rw [map_sub]
    _ = z⁺ := by rw [hfix, hzero, sub_zero]

omit [IsOrderedModule ℝ E] in
/-- The difference of nested contractive projections is a component of a positive vector. -/
private theorem nestedProjection_isLatticeComponent {P Q : E →ₗ[ℝ] E} {u : E} (hu : 0 ≤ u)
    (hPidem : ∀ x, P (P x) = P x) (hPcon : ∀ x, 0 ≤ x → 0 ≤ P x ∧ P x ≤ x)
    (hQidem : ∀ x, Q (Q x) = Q x) (hQcon : ∀ x, 0 ≤ x → 0 ≤ Q x ∧ Q x ≤ x)
    (hsubset : (LinearMap.range Q : Set E) ⊆ (LinearMap.range P : Set E)) :
    0 ≤ (P - Q) u ∧ (P - Q) u ≤ u ∧ (P - Q) u ⊓ (u - (P - Q) u) = 0 := by
  have hsub := contractiveProjection_sub hPidem hPcon hQidem hQcon hsubset
  refine ⟨(hsub.2 u hu).1, (hsub.2 u hu).2, ?_⟩
  exact contractiveProjection_disjoint_nonneg hsub.1 hsub.2 hu hu

omit [IsOrderedModule ℝ E] in
/-- Scalar bounds for an increment of principal projections, as in Freudenthal's estimate. -/
theorem freudenthal_increment_bounds {P Q : E →ₗ[ℝ] E} {w1 u : E} {α β : ℝ}
    (hPidem : ∀ x, P (P x) = P x) (hPcon : ∀ x, 0 ≤ x → 0 ≤ P x ∧ P x ≤ x)
    (hQidem : ∀ x, Q (Q x) = Q x) (hQcon : ∀ x, 0 ≤ x → 0 ≤ Q x ∧ Q x ≤ x)
    (hsubset : (LinearMap.range Q : Set E) ⊆ (LinearMap.range P : Set E))
    (hP : P (w1 - α • u) = (w1 - α • u)⁺)
    (hQ : Q (w1 - β • u) = (w1 - β • u)⁺) :
    α • (P - Q) u ≤ (P - Q) w1 ∧ (P - Q) w1 ≤ β • (P - Q) u := by
  have hQP : Q.comp P = Q :=
    contractiveProjection_comp_left_eq_of_range_subset hPidem hPcon hQidem hQcon hsubset
  have hQPy : ∀ y, Q (P y) = Q y := by
    intro y
    rw [← LinearMap.comp_apply, hQP]
  have hlow : α • (P - Q) u ≤ (P - Q) w1 := by
    set z := w1 - α • u
    have heq : (P - Q) z = z⁺ - Q z⁺ := by
      have hQz : Q z = Q z⁺ := by rw [← hQPy z, hP]
      calc
        (P - Q) z = P z - Q z := by simp only [LinearMap.sub_apply]
        _ = z⁺ - Q z := by rw [hP]
        _ = z⁺ - Q z⁺ := by rw [hQz]
    have hnn : 0 ≤ z⁺ - Q z⁺ :=
      contractiveProjection_complement_nonneg (fun y hy => (hQcon y hy).2) (posPart_nonneg z)
    have hlin : (P - Q) z = (P - Q) w1 - α • (P - Q) u := by
      rw [map_sub, map_smul]
    have hsub : 0 ≤ (P - Q) w1 - α • (P - Q) u := by
      rw [← hlin, heq]
      exact hnn
    exact (sub_nonneg).1 hsub
  have hhigh : (P - Q) w1 ≤ β • (P - Q) u := by
    set z := w1 - β • u
    have hmono : Monotone P := (monotone_iff_map_nonneg P).2 fun y hy => (hPcon y hy).1
    have hfix : P z⁺ = z⁺ := by
      refine contractiveProjection_eq_of_mem_range hPidem ?_
      exact hsubset ⟨z, hQ⟩
    have hle : (P - Q) z ≤ 0 := by
      calc
        (P - Q) z = P z - Q z := by simp only [LinearMap.sub_apply]
        _ = P z - z⁺ := by rw [hQ]
        _ ≤ P z⁺ - z⁺ := sub_le_sub_right (hmono (le_sup_left : z ≤ z⁺)) z⁺
        _ = 0 := by rw [hfix, sub_self]
    have hlin : (P - Q) z = (P - Q) w1 - β • (P - Q) u := by
      rw [map_sub, map_smul]
    have hsub : (P - Q) w1 - β • (P - Q) u ≤ 0 := by
      rw [← hlin]
      exact hle
    exact (sub_nonpos).1 hsub
  exact ⟨hlow, hhigh⟩

/-- Rescaling a vector in the principal order ideal of `u` into the order interval `[0, u]`. -/
private theorem freudenthal_rescale_bounds {u x : E} (hu : 0 ≤ u) {c : ℝ} (hc0 : 0 ≤ c)
    (hxc : |x| ≤ c • u) :
    let c1 : ℝ := c + 1
    let lam : ℝ := 2 * c1
    let w1 : E := lam⁻¹ • (x + c1 • u)
    0 < lam ∧ 0 ≤ w1 ∧ w1 ≤ u ∧ lam • w1 = x + c1 • u := by
  intro c1 lam w1
  have hc1 : 0 < c1 := by dsimp [c1]; linarith
  have hlam : 0 < lam := by dsimp [lam]; linarith
  set w : E := x + c1 • u
  have hx_le_abs : -|x| ≤ x := by
    have hneg : -x ≤ |x| := by
      rw [← abs_neg]
      exact le_abs_self (-x)
    simpa using neg_le_neg hneg
  have hc1c : c1 - c = 1 := by dsimp [c1]; ring
  have hw0 : 0 ≤ w := by
    have hbase : 0 ≤ (c1 - c) • u := by
      rw [hc1c, one_smul]
      exact hu
    have hrest : (c1 - c) • u = -(c • u) + c1 • u := by
      rw [sub_smul]
      abel
    calc
      0 ≤ (c1 - c) • u := hbase
      _ = -(c • u) + c1 • u := hrest
      _ ≤ -|x| + c1 • u := add_le_add_left (neg_le_neg hxc) _
      _ ≤ x + c1 • u := add_le_add_left hx_le_abs _
  have hclam : c + c1 ≤ lam := by dsimp [c1, lam]; linarith
  have hwlam : w ≤ lam • u := by
    calc
      w = x + c1 • u := rfl
      _ ≤ |x| + c1 • u := add_le_add_left (le_abs_self x) _
      _ ≤ c • u + c1 • u := add_le_add_left hxc _
      _ = (c + c1) • u := by rw [← add_smul]
      _ ≤ lam • u := smul_le_smul_of_nonneg_right hclam hu
  have hw10 : 0 ≤ w1 := smul_nonneg (inv_nonneg.2 hlam.le) hw0
  have hw1u : w1 ≤ u := by
    have hmul := smul_le_smul_of_nonneg_left hwlam (inv_nonneg.2 hlam.le)
    have hcancel : lam⁻¹ • (lam • u) = u := by
      rw [← mul_smul, inv_mul_cancel₀ hlam.ne', one_smul]
    have hw1_eq : w1 = lam⁻¹ • w := rfl
    rwa [← hw1_eq, hcancel] at hmul
  have hw1w : lam • w1 = w := by
    dsimp [w1]
    rw [← mul_smul, mul_inv_cancel₀ hlam.ne', one_smul]
  exact ⟨hlam, hw10, hw1u, hw1w⟩

/-- Telescoping error bounds for the Freudenthal partition sum on `[0, u]`. -/
private theorem freudenthal_partition_sum_approx {f g : ℕ → E} {w1 u : E} {N : ℕ}
    (hNpos : (0 : ℝ) < N) (hf0 : f 0 = w1) (hfN : f N = 0) (hgN : g N = 0) (hg0_le : g 0 ≤ u)
    (hpoint : ∀ i ∈ range N,
      ((i : ℝ) / (N : ℝ)) • (g i - g (i + 1)) ≤ f i - f (i + 1) ∧
        f i - f (i + 1) ≤ (((i : ℝ) + 1) / (N : ℝ)) • (g i - g (i + 1))) :
    let s : E := ∑ i ∈ range N, ((i : ℝ) / (N : ℝ)) • (g i - g (i + 1))
    0 ≤ w1 - s ∧ w1 - s ≤ ((1 : ℝ) / (N : ℝ)) • u := by
  intro s
  have htele_f : ∑ i ∈ range N, (f i - f (i + 1)) = w1 := by
    rw [Finset.sum_range_sub', hf0, hfN, sub_zero]
  have htele_g : ∑ i ∈ range N, (g i - g (i + 1)) = g 0 := by
    rw [Finset.sum_range_sub', hgN, sub_zero]
  have hs_le : s ≤ w1 := by
    have hle : s ≤ ∑ i ∈ range N, (f i - f (i + 1)) := by
      refine Finset.sum_le_sum ?_
      intro i hi
      exact (hpoint i hi).1
    exact hle.trans (le_of_eq htele_f)
  have hw1_le : w1 ≤ s + ((1 : ℝ) / (N : ℝ)) • (g 0) := by
    have hle : ∑ i ∈ range N, (f i - f (i + 1)) ≤
        ∑ i ∈ range N, (((i : ℝ) + 1) / (N : ℝ)) • (g i - g (i + 1)) := by
      refine Finset.sum_le_sum ?_
      intro i hi
      exact (hpoint i hi).2
    have hsplit : ∑ i ∈ range N, (((i : ℝ) + 1) / (N : ℝ)) • (g i - g (i + 1)) =
        s + ((1 : ℝ) / (N : ℝ)) • ∑ i ∈ range N, (g i - g (i + 1)) := by
      have hterm : ∀ i ∈ range N, (((i : ℝ) + 1) / (N : ℝ)) • (g i - g (i + 1)) =
          ((i : ℝ) / (N : ℝ)) • (g i - g (i + 1)) +
            ((1 : ℝ) / (N : ℝ)) • (g i - g (i + 1)) := by
        intro i _hi
        have hadd : ((i : ℝ) + 1) / (N : ℝ) = (i : ℝ) / (N : ℝ) + (1 : ℝ) / (N : ℝ) := by
          rw [add_div]
        rw [hadd, add_smul]
      rw [Finset.sum_congr rfl hterm, Finset.sum_add_distrib, ← Finset.smul_sum]
    rw [htele_f] at hle
    rw [hsplit, htele_g] at hle
    exact hle
  have hgnorm : ((1 : ℝ) / (N : ℝ)) • g 0 ≤ ((1 : ℝ) / (N : ℝ)) • u :=
    smul_le_smul_of_nonneg_left hg0_le (div_nonneg zero_le_one hNpos.le)
  have herr1 : 0 ≤ w1 - s := sub_nonneg.2 hs_le
  have herr2 : w1 - s ≤ ((1 : ℝ) / (N : ℝ)) • u := by
    have hle : w1 ≤ s + ((1 : ℝ) / (N : ℝ)) • u :=
      hw1_le.trans (add_le_add_right hgnorm s)
    exact (sub_le_iff_le_add').2 hle
  exact ⟨herr1, herr2⟩

omit [IsOrderedModule ℝ E] in
/-- Increments of an antitone sequence of contractive projections are pairwise disjoint. -/
private theorem freudenthal_step_disjoint {Q : ℕ → E →ₗ[ℝ] E} {u : E} (hu : 0 ≤ u)
    (hidem : ∀ k x, Q k (Q k x) = Q k x)
    (hcon : ∀ k x, 0 ≤ x → 0 ≤ Q k x ∧ Q k x ≤ x)
    (hanti : ∀ {p q : ℕ}, p ≤ q → Q q u ≤ Q p u)
    {p q : ℕ} (hpq : p < q) :
    LatticeDisjoint (Q p u - Q (p + 1) u) (Q q u - Q (q + 1) u) := by
  have hp1 : p + 1 ≤ q := Nat.succ_le_of_lt hpq
  have hgp : Q (p + 1) u ≤ Q p u := hanti (Nat.le_succ p)
  have hgq : Q (q + 1) u ≤ Q q u := hanti (Nat.le_succ q)
  have hgqp : Q q u ≤ Q (p + 1) u := hanti hp1
  have hgpu : Q p u ≤ u := (hcon p u hu).2
  have hvp : 0 ≤ Q p u - Q (p + 1) u := sub_nonneg.2 hgp
  have hvq : 0 ≤ Q q u - Q (q + 1) u := sub_nonneg.2 hgq
  have hle1 : Q p u - Q (p + 1) u ≤ u - Q (p + 1) u :=
    sub_le_sub_right hgpu (Q (p + 1) u)
  have hq1 : 0 ≤ Q (q + 1) u := (hcon (q + 1) u hu).1
  have hle2 : Q q u - Q (q + 1) u ≤ Q (p + 1) u := (sub_le_self _ hq1).trans hgqp
  have hinf0 : (u - Q (p + 1) u) ⊓ Q (p + 1) u = 0 := by
    have hdis := contractiveProjection_disjoint_nonneg (hidem (p + 1)) (hcon (p + 1)) hu hu
    rwa [inf_comm] at hdis
  rw [LatticeDisjoint, abs_of_nonneg hvp, abs_of_nonneg hvq]
  exact le_antisymm ((inf_le_inf hle1 hle2).trans (le_of_eq hinf0)) (le_inf hvp hvq)

omit [IsOrderedModule ℝ E] in
/-- Every increment of an antitone sequence of contractive projections is disjoint from the
complement of the initial projection. -/
private theorem freudenthal_rest_disjoint {Q : ℕ → E →ₗ[ℝ] E} {u : E} (hu : 0 ≤ u)
    (hidem : ∀ k x, Q k (Q k x) = Q k x)
    (hcon : ∀ k x, 0 ≤ x → 0 ≤ Q k x ∧ Q k x ≤ x)
    (hanti : ∀ {p q : ℕ}, p ≤ q → Q q u ≤ Q p u) (p : ℕ) :
    LatticeDisjoint (Q p u - Q (p + 1) u) (u - Q 0 u) := by
  have hgp : Q (p + 1) u ≤ Q p u := hanti (Nat.le_succ p)
  have hgle : Q p u ≤ Q 0 u := hanti (Nat.zero_le p)
  have hvp : 0 ≤ Q p u - Q (p + 1) u := sub_nonneg.2 hgp
  have hvr : 0 ≤ u - Q 0 u := sub_nonneg.2 (hcon 0 u hu).2
  have hp1 : 0 ≤ Q (p + 1) u := (hcon (p + 1) u hu).1
  have hle : Q p u - Q (p + 1) u ≤ Q 0 u := (sub_le_self _ hp1).trans hgle
  have h0 : Q 0 u ⊓ (u - Q 0 u) = 0 :=
    contractiveProjection_disjoint_nonneg (hidem 0) (hcon 0) hu hu
  rw [LatticeDisjoint, abs_of_nonneg hvp, abs_of_nonneg hvr]
  exact le_antisymm ((inf_le_inf_right _ hle).trans (le_of_eq h0)) (le_inf hvp hvr)

/-- The projections onto the bands generated by `(w1 - (k / N) • u)⁺`, `k ∈ ℕ`, given by the
principal projection property, form a decreasing family of contractive projections from the
identity on `w1` to zero. Their increments at `u` are components of `u` that bracket the
increments at `w1` by the scalars `k / N` and `(k + 1) / N`. -/
private theorem exists_freudenthal_projections
    (hp : ∀ u : E, ∃ P : E →ₗ[ℝ] E,
      (LinearMap.range P : Set E) =
        latticeDisjointComplement (latticeDisjointComplement {u}) ∧
      (∀ x, P (P x) = P x) ∧ ∀ x, 0 ≤ x → 0 ≤ P x ∧ P x ≤ x)
    {u w1 : E} (hu : 0 ≤ u) (hw10 : 0 ≤ w1) (hw1u : w1 ≤ u) {N : ℕ} (hN : (0 : ℝ) < N) :
    ∃ Q : ℕ → E →ₗ[ℝ] E, (∀ k y, Q k (Q k y) = Q k y) ∧
      (∀ k y, 0 ≤ y → 0 ≤ Q k y ∧ Q k y ≤ y) ∧
      (∀ {p q : ℕ}, p ≤ q → Q q u ≤ Q p u) ∧ Q 0 w1 = w1 ∧ (∀ y, Q N y = 0) ∧
      (∀ i : ℕ, ((i : ℝ) / N) • (Q i u - Q (i + 1) u) ≤ Q i w1 - Q (i + 1) w1 ∧
        Q i w1 - Q (i + 1) w1 ≤ (((i : ℝ) + 1) / N) • (Q i u - Q (i + 1) u)) ∧
      ∀ i : ℕ, 0 ≤ Q i u - Q (i + 1) u ∧ Q i u - Q (i + 1) u ≤ u ∧
        (Q i u - Q (i + 1) u) ⊓ (u - (Q i u - Q (i + 1) u)) = 0 := by
  choose proj hrange hidem hcon using hp
  have happly : ∀ t : ℝ, proj (w1 - t • u)⁺ (w1 - t • u) = (w1 - t • u)⁺ := fun t ↦
    projection_eq_posPart (hrange _) (hidem _) (hcon _)
  have hrange_anti : ∀ {s t : ℝ}, s ≤ t → (LinearMap.range (proj (w1 - t • u)⁺) : Set E) ⊆
      (LinearMap.range (proj (w1 - s • u)⁺) : Set E) := by
    intro s t hst
    rw [hrange, hrange]
    exact doubleLatticeDisjointComplement_mono (posPart_nonneg _)
      (sup_le_sup_right (sub_le_sub_left (smul_le_smul_of_nonneg_right hst hu) w1) 0)
  have hproj0 : proj (w1 - (0 : ℝ) • u)⁺ w1 = w1 := by
    refine contractiveProjection_eq_of_mem_range (hidem _) ?_
    rw [← SetLike.mem_coe, hrange, zero_smul, sub_zero, posPart_eq_self.mpr hw10]
    exact mem_doubleLatticeDisjointComplement w1
  have hproj1 : ∀ y, proj (w1 - (1 : ℝ) • u)⁺ y = 0 := by
    have hR : (LinearMap.range (proj (w1 - (1 : ℝ) • u)⁺) : Set E) = {0} := by
      rw [hrange, one_smul, posPart_eq_zero.2 (sub_nonpos.2 hw1u),
        doubleLatticeDisjointComplement_zero]
    intro y
    have hy : proj (w1 - (1 : ℝ) • u)⁺ y ∈ (LinearMap.range (proj (w1 - (1 : ℝ) • u)⁺) : Set E) :=
      LinearMap.mem_range_self _ y
    rwa [hR, Set.mem_singleton_iff] at hy
  have hdiv : ∀ {a b : ℝ}, a ≤ b → a / N ≤ b / N := fun h ↦ div_le_div_of_nonneg_right h hN.le
  have hsucc : ∀ i : ℕ, (i : ℝ) / N ≤ ((i : ℝ) + 1) / N := fun i ↦ hdiv (by linarith)
  refine ⟨fun k ↦ proj (w1 - ((k : ℝ) / N) • u)⁺, fun k ↦ hidem _, fun k ↦ hcon _, ?_, ?_, ?_,
    fun i ↦ ?_, fun i ↦ ?_⟩
  · intro p q hpq
    exact contractiveProjection_le_of_range_subset (hidem _) (hcon _) (hcon _)
      (hrange_anti (hdiv (Nat.cast_le.mpr hpq))) hu
  · simpa only [Nat.cast_zero, zero_div] using hproj0
  · simpa only [div_self hN.ne'] using hproj1
  · simpa only [Nat.cast_add, Nat.cast_one, LinearMap.sub_apply] using
      freudenthal_increment_bounds (hidem _) (hcon _) (hidem _) (hcon _)
        (hrange_anti (hsucc i)) (happly _) (happly _)
  · simpa only [Nat.cast_add, Nat.cast_one, LinearMap.sub_apply] using
      nestedProjection_isLatticeComponent hu (hidem _) (hcon _) (hidem _) (hcon _)
        (hrange_anti (hsucc i))

omit [Lattice E] [IsOrderedAddMonoid E] [IsOrderedModule ℝ E] in
/-- The Freudenthal combination of the increments `g i - g (i + 1)`, `i < N`, and the remainder
`u - g 0`, with coefficients `lam * (i / N) - c1` and `-c1`, is `lam • s - c1 • u`, where `s`
is the lower partition sum. -/
private theorem freudenthal_sum_snoc (g : ℕ → E) (u : E) (N : ℕ) (lam c1 : ℝ) (hgN : g N = 0) :
    ∑ i : Fin (N + 1),
      (Fin.snoc (fun i : Fin N ↦ lam * ((i : ℝ) / N) - c1) (-c1) : Fin (N + 1) → ℝ) i •
        (Fin.snoc (fun i : Fin N ↦ g i - g (i + 1)) (u - g 0) : Fin (N + 1) → E) i =
      lam • ∑ i ∈ range N, ((i : ℝ) / N) • (g i - g (i + 1)) - c1 • u := by
  rw [Fin.sum_univ_castSucc]
  simp only [Fin.snoc_castSucc, Fin.snoc_last]
  rw [Fin.sum_univ_eq_sum_range (fun i ↦ (lam * ((i : ℝ) / N) - c1) • (g i - g (i + 1))) N]
  have hterm : ∀ i ∈ range N, (lam * ((i : ℝ) / N) - c1) • (g i - g (i + 1)) =
      lam • (((i : ℝ) / N) • (g i - g (i + 1))) - c1 • (g i - g (i + 1)) :=
    fun i _ ↦ by rw [sub_smul, mul_smul]
  rw [Finset.sum_congr rfl hterm, Finset.sum_sub_distrib, ← Finset.smul_sum, ← Finset.smul_sum,
    Finset.sum_range_sub', hgN, sub_zero, neg_smul, smul_sub]
  abel

omit [IsOrderedModule ℝ E] in
/-- The increments of a decreasing family of contractive projections at `u`, completed by the
remainder `u - Q 0 u`, are pairwise disjoint. -/
private theorem freudenthal_snoc_disjoint {Q : ℕ → E →ₗ[ℝ] E} {u : E} (hu : 0 ≤ u)
    (hidem : ∀ k x, Q k (Q k x) = Q k x)
    (hcon : ∀ k x, 0 ≤ x → 0 ≤ Q k x ∧ Q k x ≤ x)
    (hanti : ∀ {p q : ℕ}, p ≤ q → Q q u ≤ Q p u) {N : ℕ} (i j : Fin (N + 1)) (hij : i ≠ j) :
    LatticeDisjoint
      ((Fin.snoc (fun i : Fin N ↦ Q i u - Q (i + 1) u) (u - Q 0 u) : Fin (N + 1) → E) i)
      ((Fin.snoc (fun i : Fin N ↦ Q i u - Q (i + 1) u) (u - Q 0 u) : Fin (N + 1) → E) j) := by
  induction i using Fin.lastCases with
  | last =>
    induction j using Fin.lastCases with
    | last => exact absurd rfl hij
    | cast j =>
      simpa only [Fin.snoc_last, Fin.snoc_castSucc] using
        (freudenthal_rest_disjoint hu hidem hcon hanti j).symm
  | cast i =>
    induction j using Fin.lastCases with
    | last =>
      simpa only [Fin.snoc_last, Fin.snoc_castSucc] using
        freudenthal_rest_disjoint hu hidem hcon hanti i
    | cast j =>
      simp only [Fin.snoc_castSucc]
      have hij' : (i : ℕ) ≠ j := fun h ↦ hij (congrArg Fin.castSucc (Fin.ext h))
      rcases lt_or_gt_of_ne hij' with hlt | hgt
      · exact freudenthal_step_disjoint hu hidem hcon hanti hlt
      · exact (freudenthal_step_disjoint hu hidem hcon hanti hgt).symm

/-- Rescaling the mesh estimate `0 ≤ w1 - s ≤ (1 / N) • u` gives the order error of the
Freudenthal approximation of `x = lam • w1 - c1 • u`. -/
private theorem freudenthal_error_le {x w1 s u : E} {lam c1 ε : ℝ} {N : ℕ} (hlam : 0 < lam)
    (hu : 0 ≤ u) (hdiv : lam / N < ε) (hw1 : lam • w1 = x + c1 • u) (herr1 : 0 ≤ w1 - s)
    (herr2 : w1 - s ≤ ((1 : ℝ) / N) • u) :
    |x - (lam • s - c1 • u)| ≤ ε • u := by
  have herr : x - (lam • s - c1 • u) = lam • (w1 - s) := by
    rw [smul_sub, hw1]
    abel
  rw [herr, abs_smul, abs_of_nonneg hlam.le, abs_of_nonneg herr1]
  calc
    lam • (w1 - s) ≤ lam • (((1 : ℝ) / N) • u) := smul_le_smul_of_nonneg_left herr2 hlam.le
    _ = (lam / N) • u := by rw [smul_smul, mul_one_div]
    _ ≤ ε • u := smul_le_smul_of_nonneg_right hdiv.le hu

/-- **Freudenthal approximation** from the principal projection property.
`hp` is the raw form of `HasPrincipalBandProjections`. -/
theorem freudenthal_components
    (hp : ∀ u : E, ∃ P : E →ₗ[ℝ] E,
      (LinearMap.range P : Set E) =
        latticeDisjointComplement (latticeDisjointComplement {u}) ∧
      (∀ x, P (P x) = P x) ∧ ∀ x, 0 ≤ x → 0 ≤ P x ∧ P x ≤ x)
    {u x : E} (hu : 0 ≤ u) (hx : ∃ c : ℝ, 0 ≤ c ∧ |x| ≤ c • u) {ε : ℝ} (hε : 0 < ε) :
    ∃ (n : ℕ) (a : Fin n → ℝ) (v : Fin n → E),
      (∀ i, 0 ≤ v i ∧ v i ≤ u ∧ v i ⊓ (u - v i) = 0) ∧
      (∀ i j, i ≠ j → LatticeDisjoint (v i) (v j)) ∧
      |x - ∑ i, a i • v i| ≤ ε • u := by
  obtain ⟨c, hc0, hxc⟩ := hx
  set c1 : ℝ := c + 1
  set lam : ℝ := 2 * c1
  set w1 : E := lam⁻¹ • (x + c1 • u)
  obtain ⟨hlam, hw10, hw1u, hw1w⟩ := freudenthal_rescale_bounds hu hc0 hxc
  obtain ⟨N, hN⟩ := exists_nat_gt (lam / ε)
  have hNpos : (0 : ℝ) < N := (div_pos hlam hε).trans hN
  have hdiv : lam / N < ε := by
    rw [div_lt_iff₀ hε] at hN
    rw [div_lt_iff₀ hNpos]
    linarith
  obtain ⟨Q, hQidem, hQcon, hQanti, hQ0, hQN, hpoint, hstep⟩ :=
    exists_freudenthal_projections hp hu hw10 hw1u hNpos
  obtain ⟨herr1, herr2⟩ := freudenthal_partition_sum_approx (f := fun k ↦ Q k w1)
    (g := fun k ↦ Q k u) hNpos hQ0 (hQN w1) (hQN u) (hQcon 0 u hu).2 fun i _ ↦ hpoint i
  refine ⟨N + 1, Fin.snoc (fun i : Fin N ↦ lam * ((i : ℝ) / N) - c1) (-c1),
    Fin.snoc (fun i : Fin N ↦ Q i u - Q (i + 1) u) (u - Q 0 u), fun i ↦ ?_,
    freudenthal_snoc_disjoint hu hQidem hQcon hQanti, ?_⟩
  · induction i using Fin.lastCases with
    | last =>
      simp only [Fin.snoc_last, sub_sub_cancel]
      refine ⟨sub_nonneg.2 (hQcon 0 u hu).2, sub_le_self _ (hQcon 0 u hu).1, ?_⟩
      rw [inf_comm]
      exact contractiveProjection_disjoint_nonneg (hQidem 0) (hQcon 0) hu hu
    | cast i => simpa only [Fin.snoc_castSucc] using hstep i
  · rw [freudenthal_sum_snoc (fun k ↦ Q k u) u N lam c1 (hQN u)]
    exact freudenthal_error_le hlam hu hdiv hw1w herr1 herr2

end CKMA
